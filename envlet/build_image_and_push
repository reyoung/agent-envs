#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "${ROOT_DIR}/envlet"
source "${ROOT_DIR}/tools/docker/build_and_push_cmds.sh"

IMAGE_REPO=${IMAGE_REPO:-"reyoung/envlet"}
BASE_TAG=${BASE_TAG:-"0.1.0"}
TAG_SUFFIX=${TAG_SUFFIX:-""}

main() {
	local suffix tag
	if [[ -n "${TAG_SUFFIX}" ]]; then
		suffix="${TAG_SUFFIX}"
	else
		suffix=$(git describe --tags --always --dirty)
		suffix=$(sanitize_tag "${suffix}")
	fi
	tag="${BASE_TAG}-${suffix}"

	echo "Building linux envlet binary with make"
	make clean
	make linux -j

	echo "Building go-sandbox binary"
	cd 3rd/go-sandbox
	GOOS=linux GOARCH=amd64 go build -o runprog ./cmd/runprog
	mv runprog ../../bin
	cd ../..

	echo "Building ${IMAGE_REPO}:${tag}"
	"${BUILD_CMDS[@]}" -f Dockerfile -t "${IMAGE_REPO}:${tag}" .

	echo "Pushing ${IMAGE_REPO}:${tag}"
	"${PUSH_CMDS[@]}" "${IMAGE_REPO}:${tag}"
}

sanitize_tag() {
	local input=$1
	input=${input//\//-}
	input=${input//[^0-9A-Za-z_.-]/-}
	echo "${input}"
}

main "$@"
