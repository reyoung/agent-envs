#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "${ROOT_DIR}/tools/docker/build_and_push_cmds.sh"

IMAGE_REPO=${IMAGE_REPO:-"reyoung/codeforces_bin"}
BASE_TAG=${BASE_TAG:-"0.1.0"}
TAG_SUFFIX=${TAG_SUFFIX:-""}

main() {
	local suffix tag
	if [[ -n "${TAG_SUFFIX}" ]]; then
		suffix="${TAG_SUFFIX}"
	else
		suffix=$(git -C "${ROOT_DIR}" describe --tags --always --dirty)
		suffix=$(sanitize_tag "${suffix}")
	fi
	tag="${BASE_TAG}-${suffix}"

	echo "Building linux cf_case binary with make"
	make -C "${ROOT_DIR}/tools/codeforces_bin" clean
	make -C "${ROOT_DIR}/tools/codeforces_bin" linux

	local data_source
	data_source="${ROOT_DIR}/tools/codeforces_bin/cmd/cf_case/data/codeforces_problems.bin"
	if [[ ! -f "${data_source}" ]]; then
		echo "Missing data file: ${data_source}" >&2
		exit 1
	fi

	echo "Building ${IMAGE_REPO}:${tag}"
	"${BUILD_CMDS[@]}" \
		-f "${ROOT_DIR}/tools/codeforces_bin/Dockerfile" \
		-t "${IMAGE_REPO}:${tag}" \
		"${ROOT_DIR}/tools/codeforces_bin"

	echo "Pushing ${IMAGE_REPO}:${tag}"
	"${PUSH_CMDS[@]}" "${IMAGE_REPO}:${tag}"
}

sanitize_tag() {
	local input=$1
	input=${input//\//-}
	input=${input//[^0-9A-Za-z_.-]/-}
	echo "${input}"
}

main "$@"
